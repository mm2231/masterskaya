{
  "name": "masterskaya",
  "version": "2.0.0",
  "private": true,
  "description": "CRM мастерской по ремонту телефонов: заказы, акты, клиенты, финансы",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @masterskaya/api",
    "dev:api": "npm run dev --workspace @masterskaya/api",
    "dev:web": "npm run dev --workspace @masterskaya/web",
    "build:packages": "npm run build --workspace @masterskaya/shared && npm run build --workspace @masterskaya/db",
    "build:app": "npm run build --workspace @masterskaya/web && npm run build --workspace @masterskaya/api",
    "build": "npm run build:packages && npm run build:app",
    "start": "npm run start --workspace @masterskaya/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @masterskaya/db",
    "db:migrate": "npm run db:migrate --workspace @masterskaya/db",
    "db:seed": "npm run db:seed --workspace @masterskaya/db",
    "db:reset": "npm run db:reset --workspace @masterskaya/db",
    "import:legacy": "npm run import:legacy --workspace @masterskaya/api",
    "build:portable": "node scripts/build-portable.mjs",
    "data:export": "node scripts/export-data.mjs",
    "data:import": "node scripts/import-data.mjs",
    "data:backup": "node scripts/backup-db.mjs",
    "backup:check": "node scripts/backup-check.mjs",
    "update:check": "node scripts/apply-update.mjs check",
    "update:install": "node scripts/apply-update.mjs install",
    "setup": "node scripts/setup.mjs",
    "launch": "node scripts/launch.mjs",
    "stop": "node scripts/stop.mjs",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
