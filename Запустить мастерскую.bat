@echo off
chcp 65001 >nul
rem ═══════════════════════════════════════════════════════════════════
rem  Запуск «Мастерской» двойным щелчком (Windows).
rem
rem  Сервер поднимается в фоне, браузер открывается сам.
rem  Если не запустилось — в этом окне будет причина и журнал.
rem ═══════════════════════════════════════════════════════════════════
cd /d "%~dp0"

rem ── Node.js ─────────────────────────────────────────────────────────────
set "PATH=%CD%\.node;%PATH%"
where node >nul 2>&1
if errorlevel 1 (
  echo.
  echo Не найден Node.js 20 или новее.
  echo.
  echo Установите его с nodejs.org и откройте этот файл ещё раз,
  echo либо запустите в этой папке install.cmd — он поставит Node сам.
  echo.
  pause
  exit /b 1
)

rem ── Запуск ──────────────────────────────────────────────────────────────
node scripts\launch.mjs
if errorlevel 1 (
  echo.
  echo Приложение не запустилось. Подробности — выше.
  echo Журнал: data\app.log
  echo.
  pause
  exit /b 1
)
exit /b 0
