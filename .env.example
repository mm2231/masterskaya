# ── Сервер ───────────────────────────────────────────────────────────────
# Порт локального сервера. 8080 выбран по умолчанию: на macOS порт 5000
# часто занят системным «AirPlay Receiver».
PORT=8080
# 0.0.0.0 — доступ по локальной сети (с телефона/другого ПК), 127.0.0.1 — только этот ПК.
HOST=0.0.0.0
# 1 — режим разработки (Vite раздаёт фронт, API на отдельном порту).
DEV=0

# ── Часовой пояс ──────────────────────────────────────────────────────────
# Смещение в часах от UTC: 3 — Минск и Москва, 2 — Калининград, 0 — Лондон.
# В базе всё время хранится в этой зоне, поэтому даты в актах и сводках
# совпадают с вашими часами. Если оставить пустым — берётся время системы.
TIMEZONE_OFFSET_HOURS=3

# ── База данных ──────────────────────────────────────────────────────────
# Путь к файлу SQLite относительно корня репозитория.
DATABASE_PATH=data/workshop.db
# Папка для автоматических резервных копий.
BACKUP_DIR=data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# ── Реквизиты мастерской ────────────────────────────────────────────────
# Подставляются в приёмный акт, акт выполненных работ и счета.
WORKSHOP_NAME=Моя мастерская
WORKSHOP_OWNER=
WORKSHOP_UNP=
WORKSHOP_ADDRESS=
WORKSHOP_PHONE=

# ── Безопасность ────────────────────────────────────────────────────────
# Пароль на вход. Пусто — вход без пароля.
APP_PASSWORD=
# Ключ подписи сессии. Задайте постоянное случайное значение, иначе при
# каждом перезапуске придётся входить заново.
# При установке (npm run setup) генерируется автоматически.
SECRET_KEY=

# ── Нумерация документов ────────────────────────────────────────────────
# Шаблон номера акта. Доступные подстановки: {YYYY} — год, {MM} — месяц,
# {SEQ} — порядковый номер в пределах периода.
DOC_NUMBER_PATTERN={YYYY}-{SEQ}
# Шаблон номера заказа.
ORDER_NUMBER_PATTERN={YYYY}-{SEQ}
